{
  "name": "pictile",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:dock && pnpm run build:source",
    "build:dock": "vite build --mode dock",
    "build:source": "vite build --mode source",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "extract-licenses": "pnpm license-checker --customPath ./license-format.json --json | node scripts/generate-licenses.js",
    "package": "cd dist && zip -r pictile.zip . -x \"*.DS_Store\" -x \"pictile*\" && cd .."
  },
  "devDependencies": {
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^0.511.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/image-blob-reduce": "^4.1.4",
    "@types/node": "^22.15.29",
    "bits-ui": "^2.8.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "image-blob-reduce": "^4.1.0",
    "license-checker": "^25.0.1",
    "lucide-svelte": "^0.513.0",
    "mode-watcher": "^1.0.7",
    "svelte": "^5.28.1",
    "svelte-check": "^4.1.6",
    "svelte-sonner": "^1.0.4",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^1.0.0",
    "tailwindcss": "^4.1.8",
    "tw-animate-css": "^1.3.3",
    "typescript": "~5.8.3",
    "valibot": "^1.1.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
